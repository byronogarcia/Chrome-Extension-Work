{
  "manifest_version": 3,
  "name": "TESTING - Giva CC Autofill",
  "description": "Inserts user IDs into Customer CC field.",
  "version": "1.5",
  "icons": {
    "16": "images/sante16.png",
    "32": "images/sante32.png",
    "48": "images/sante48.png",
    "128": "images/sante128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "images/sante16.png",
      "32": "images/sante32.png",
      "48": "images/sante48.png",
      "128": "images/sante128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://santehealth.giva.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://santehealth.giva.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill Customer CC field with user IDs."
    }
  }
}